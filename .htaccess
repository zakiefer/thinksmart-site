# Think Smart Public Adjusting — Apache config (GoDaddy cPanel).
# Assumes the site is uploaded to the domain's web root (public_html).

# Serve the homepage at the bare domain; index.html remains the fallback.
DirectoryIndex Home.dc.html index.html

Options -Indexes

<Files ".user.ini">
  Require all denied
</Files>
ErrorDocument 404 /404.html

AddType image/webp .webp
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
RewriteEngine On

# Uncomment these four lines once the SSL certificate is active for BOTH
# thinksmartpublicadjusting.com and www.thinksmartpublicadjusting.com:
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
# RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

# Old Wix URLs -> new pages, so existing search results and bookmarks keep working.
RewriteRule ^(about|about-5|copy-of-meet)/?$ /About.dc.html [R=301,L]
RewriteRule ^services/?$ /Services.dc.html [R=301,L]
RewriteRule ^what-we-cover/?$ /Services.dc.html#cover [R=301,L,NE]
RewriteRule ^frequently-asked-questions/?$ /FAQ.dc.html [R=301,L]
RewriteRule ^contact/?$ /Contact.dc.html [R=301,L]
RewriteRule ^file-a-claim/?$ /Claim.dc.html [R=301,L]
RewriteRule ^copy-of-file-a-claim(-1)?/?$ /Claim.dc.html [R=301,L]
RewriteRule ^_files/ugd/274ef5_(9f0b81b399a04b61aa9017dead4975c3|0863a1590d7b4c4180bcee97eb5af741)\.pdf$ /docs/think-smart-agreement-indiana.pdf [R=301,L]
RewriteRule ^_files/ugd/274ef5_(ef650220209045328e86b9d35054d796|19ebdb6af92b457783833f052ffac194)\.pdf$ /docs/think-smart-agreement-kentucky.pdf [R=301,L]
</IfModule>

<IfModule mod_headers.c>
# Pages and the runtime revalidate on every visit so edits show up immediately.
<FilesMatch "\.(html|js|php)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(webp|png|mp4|pdf)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

AddDefaultCharset UTF-8
